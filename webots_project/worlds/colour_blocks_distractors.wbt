#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Colour-block search with distractors: the three blocks plus a red ball,"
    "a green cylinder and a blue ball. HSV colour detection cannot tell them"
    "apart; the shape CNN trained in Webots can."
  ]
  title "Colour block detection with distractors"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5774 0.5774 0.5774 2.0944
  position 0 0 5.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 3 3
  floorTileSize 3 3
  floorAppearance PBRAppearance {
    baseColor 0.65 0.65 0.65
    roughness 1
    metalness 0
  }
  wallHeight 0.15
}
DEF RED_BLOCK Solid {
  translation 0.9 0.6 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.05 0.05
        roughness 1
        metalness 0
      }
      geometry DEF BLOCK_BOX Box {
        size 0.3 0.3 0.1
      }
    }
  ]
  name "red block"
  boundingObject USE BLOCK_BOX
  physics Physics {
    density -1
    mass 2
  }
}
DEF GREEN_BLOCK Solid {
  translation -0.8 0.9 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.8 0.05
        roughness 1
        metalness 0
      }
      geometry USE BLOCK_BOX
    }
  ]
  name "green block"
  boundingObject USE BLOCK_BOX
  physics Physics {
    density -1
    mass 2
  }
}
DEF BLUE_BLOCK Solid {
  translation 0.2 -1 0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.1 0.9
        roughness 1
        metalness 0
      }
      geometry USE BLOCK_BOX
    }
  ]
  name "blue block"
  boundingObject USE BLOCK_BOX
  physics Physics {
    density -1
    mass 2
  }
}
DEF DISTRACTOR_1 Solid {
  translation 0 0 0.1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.05 0.05
        roughness 1
        metalness 0
      }
      geometry DEF DISTRACTOR_1_GEOM Sphere {
        radius 0.1
        subdivision 3
      }
    }
  ]
  name "distractor 1"
  boundingObject USE DISTRACTOR_1_GEOM
}
DEF DISTRACTOR_2 Solid {
  translation 0 0 0.1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.8 0.05
        roughness 1
        metalness 0
      }
      geometry DEF DISTRACTOR_2_GEOM Cylinder {
        height 0.2
        radius 0.08
      }
    }
  ]
  name "distractor 2"
  boundingObject USE DISTRACTOR_2_GEOM
}
DEF DISTRACTOR_3 Solid {
  translation 0 0 0.09
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.1 0.9
        roughness 1
        metalness 0
      }
      geometry DEF DISTRACTOR_3_GEOM Sphere {
        radius 0.09
        subdivision 3
      }
    }
  ]
  name "distractor 3"
  boundingObject USE DISTRACTOR_3_GEOM
}
DEF EPUCK E-puck {
  translation 0 0 0
  controller "colour_detector"
}
Robot {
  name "block randomiser"
  controller "block_randomiser"
  supervisor TRUE
}
