#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/toyota/ToyotaPriusSimple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/protos/generic/TruckSimple.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/animals/protos/Horse.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/animals/protos/Deer.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/toys/protos/PaperBoat.proto"

WorldInfo {
  info [
    "CNN object tour (separate demo world): an e-puck visits three coloured blocks"
    "and five CIFAR-10 objects (car, truck, horse, deer, paper boat). Blocks are"
    "checked with HSV colour detection; objects are named by the CIFAR-10 CNN."
    "Objects are real size, so each sits at its own distance from the centre:"
    "the robot stops where the object fills its camera view. Blocks sit 3.5 m out."
    "The view follows the robot; the yellow ball on top is only a display marker."
    "Sensors: lidar (finds objects), GPS and inertial unit (own pose), camera (names them)."
    "Controller: object_finder."
  ]
  title "CNN object tour"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.3299 0.3299 0.8845 1.6933
  position 0.0 -15.0 13.0
  follow "e-puck"
  followType "Tracking Shot"
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 30 30
  floorTileSize 2 2
  wallHeight 0.3
}
DEF RED_BLOCK Solid {
  translation 3.5 0.0 0.25
  rotation 0 0 1 1.5708
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.05 0.05
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.5 0.5 0.5
      }
    }
  ]
  name "red block"
  boundingObject Box {
    size 0.5 0.5 0.5
  }
}
DEF CAR ToyotaPriusSimple {
  translation -6.364 -6.364 0.4
  rotation 0 0 1 5.4978
  color 0.75 0.08 0.08
  name "car"
}
DEF GREEN_BLOCK Solid {
  translation 0.0 3.5 0.25
  rotation 0 0 1 3.1416
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.8 0.05
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.5 0.5 0.5
      }
    }
  ]
  name "green block"
  boundingObject Box {
    size 0.5 0.5 0.5
  }
}
DEF HORSE Horse {
  translation -4.738 4.738 0
  rotation 0 0 1 3.927
  name "horse"
}
DEF BLUE_BLOCK Solid {
  translation -3.5 0.0 0.25
  rotation 0 0 1 4.7124
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.1 0.9
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.5 0.5 0.5
      }
    }
  ]
  name "blue block"
  boundingObject Box {
    size 0.5 0.5 0.5
  }
}
DEF TRUCK TruckSimple {
  translation 7.212 7.212 0.5
  rotation 0 0 1 4.527
  trailer NULL
  name "truck"
}
DEF DEER Deer {
  translation 3.677 -3.677 0
  rotation 0 0 1 7.0686
  name "deer"
}
# Flat sea-coloured patch under and behind the paper boat, out to the robot's
# horizon (shape only, no physics).
# Its hue (about 98 on OpenCV's 0-179 scale) is below the blue-block range
# (105-130), so the HSV detector does not mistake it for a blue block.
DEF WATER Pose {
  translation 0 -4 0.002
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.32 0.42
        roughness 0.15
        metalness 0
      }
      geometry Plane {
        size 5 7
      }
    }
  ]
}
DEF BOAT PaperBoat {
  translation -0.0 -1.75 0
  rotation 0 0 1 6.2832
  name "boat"
}
DEF EPUCK E-puck {
  translation 0 0 0
  controller "object_finder"
  supervisor TRUE
  camera_width 160
  camera_height 120
  turretSlot [
    # Sensors for the autonomous tour: a 360-degree, 8-layer lidar finds the
    # objects; GPS and the inertial unit give the robot its own position and heading.
    Lidar {
      translation 0 0 0.05
      name "lidar"
      horizontalResolution 720
      fieldOfView 6.2832
      verticalFieldOfView 0.4
      numberOfLayers 8
      minRange 0.08
      maxRange 14
      type "fixed"
    }
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial unit"
    }
    # Display marker only (no physics): a tall yellow pole and ball so the
    # small e-puck is easy to follow on a projector. It sits behind and
    # above the camera, so it never appears in the robot's own images.
    Pose {
      translation 0 0 0.2
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.8 0
            emissiveColor 0.6 0.45 0
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.4
            radius 0.025
          }
        }
        Pose {
          translation 0 0 0.4
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 1 0.8 0
                emissiveColor 0.6 0.45 0
                roughness 1
                metalness 0
              }
              geometry Sphere {
                radius 0.25
              }
            }
          ]
        }
      ]
    }
  ]
}
